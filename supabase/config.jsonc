{
  "$schema": "https://supabase.com/schemas/config/v1.json",
  "project_id": "presente-doce",
  // Prepared for review with config diff. Local file alone does not change hosted Auth.
  // CLI 3.1+ only; undeclared resources must remain unchanged.
  "auth": {
    "site_url": "https://presente-doce.vercel.app",
    "additional_redirect_urls": ["https://presente-doce.vercel.app/admin?recuperar=1"],
    "enable_signup": false,
    "enable_anonymous_sign_ins": false,
    "minimum_password_length": 12,
    "password_requirements": "",
    "jwt_expiry": 3600,
    "enable_refresh_token_rotation": true,
    "refresh_token_reuse_interval": 10,
    "rate_limit": {
      "sign_in_sign_ups": 30,
      "token_refresh": 150,
      "token_verifications": 30
    },
    "email": {
      "enable_confirmations": true,
      "double_confirm_changes": true,
      "require_current_password": true,
      "secure_password_change": true,
      "max_frequency": "1m",
      "otp_expiry": 3600
    }
  }
}
